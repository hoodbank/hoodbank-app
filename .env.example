# Server only. This key controls every card issued under the account — it can
# create them, read their numbers, and drain them. Never expose it to a client.
KRIPICARD_API_KEY=

# Optional. The public docs page advertises home.kripicard.com/api/premium/*,
# which 404s; the default below is the live API. Only set this if that changes.
# KRIPICARD_BASE_URL=https://appapi.kripicard.com

# Optional override for the /api/rpc proxy target. Needed in local dev only if
# your ISP DNS-blocks rpc.*.chain.robinhood.com (Indonesian ISPs do).
# PublicNode carries chain 4663 (verified via eth_chainId) and is reachable.
# Leave unset in production: Vercel reaches the official RPC directly.
# EVM_RPC_URL=https://robinhood-rpc.publicnode.com

# Postgres for card ownership + deposits (Neon free tier works). REQUIRED in
# production: without it the JSON fallback refuses to run on Vercel, because a
# read-only filesystem would lose cards that were already paid for.
DATABASE_URL=

# Privy App ID — public/publishable, used by PrivyProvider in the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only: verifies Privy access tokens so API routes know who is calling.
# This is the only thing making card ownership real — without it a route would
# have to trust an address supplied by the caller.
PRIVY_APP_SECRET=
